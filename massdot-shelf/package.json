{
  "name": "massdot-shelf",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web",
    "studio"
  ],
  "scripts": {
    "build": "npm run build --workspace web",
    "dev": "npm run dev --workspace web",
    "dev:studio": "npm run dev --workspace studio",
    "lint": "npm run lint --workspace web && npm run lint --workspace studio",
    "typegen": "npm run typegen --workspace studio",
    "test": "npm run test --workspace web"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
